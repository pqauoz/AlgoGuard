   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import joblib\n",
    "import os\n",
    "import time\n",
    "import pickle\n",
    "import psutil\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "from sklearn.metrics import (accuracy_score, precision_score, recall_score, \n",
    "                             f1_score, roc_auc_score, confusion_matrix)\n",
    "\n",
    "#  5 base models\n",
    "from sklearn.neighbors import KNeighborsClassifier\n",
    "from sklearn.naive_bayes import GaussianNB\n",
    "from sklearn.ensemble import RandomForestClassifier, AdaBoostClassifier, GradientBoostingClassifier\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "dac616ec",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Data loaded successfully. X_train shape: (65914, 10)\n"
     ]
    }
   ],
   "source": [
    "# Load Preprocessed Data\n",
    "processed_path = '../dataset/processed/'\n",
    "X_train = joblib.load(os.path.join(processed_path, 'X_train_scaled.pkl'))\n",
    "X_test  = joblib.load(os.path.join(processed_path, 'X_test_scaled.pkl'))\n",
    "y_train = joblib.load(os.path.join(processed_path, 'y_train.pkl'))\n",
    "y_test  = joblib.load(os.path.join(processed_path, 'y_test.pkl'))\n",
    "\n",
    "print(f\"Data loaded successfully. X_train shape: {X_train.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "43f08f0f",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Master Evaluation Function\n",
    "def evaluate_model(name, model, X_train, y_train, X_test, y_test):\n",
    "    metrics = {'Model': name}\n",
    "    process = psutil.Process(os.getpid())\n",
    "    process.cpu_percent(interval=None)\n",
    "\n",
    "    # Training Metrics\n",
    "    ram_before = process.memory_info().rss\n",
    "    start_train = time.time()\n",
    "    model.fit(X_train, y_train)\n",
    "    end_train = time.time()\n",
    "    ram_after = process.memory_info().rss\n",
    "    \n",
    "    metrics['Training Time (s)'] = round(end_train - start_train, 4)\n",
    "    metrics['CPU Usage (%)'] = round(process.cpu_percent(interval=None), 2)\n",
    "    metrics['RAM Usage (MB)'] = round(abs((ram_after - ram_before) / (1024 * 1024)), 2)\n",
    "\n",
    "    # Prediction Metrics\n",
    "    start_predict = time.time()\n",
    "    y_pred = model.predict(X_test)\n",
    "    end_predict = time.time()\n",
    "    metrics['Prediction Time (s)'] = round(end_predict - start_predict, 4)\n",
    "\n",
    "    # Model Size\n",
    "    model_size_bytes = len(pickle.dumps(model))\n",
    "    metrics['Model Size (MB)'] = round(model_size_bytes / (1024 * 1024), 4)\n",
    "\n",
    "    # Classification Metrics\n",
    "    is_binary = len(np.unique(y_test)) == 2\n",
    "    avg_method = 'binary' if is_binary else 'weighted'\n",
    "\n",
    "    metrics['Accuracy'] = round(accuracy_score(y_test, y_pred), 4)\n",
    "    metrics['Precision'] = round(precision_score(y_test, y_pred, average=avg_method, zero_division=0), 4)\n",
    "    metrics['Recall'] = round(recall_score(y_test, y_pred, average=avg_method, zero_division=0), 4)\n",
    "    metrics['F1'] = round(f1_score(y_test, y_pred, average=avg_method, zero_division=0), 4)\n",
    "\n",
    "    # Specificity and FPR\n",
    "    cm = confusion_matrix(y_test, y_pred)\n",
    "    if is_binary:\n",
    "        tn, fp, fn, tp = cm.ravel()\n",
    "        metrics['Specificity'] = round(tn / (tn + fp) if (tn + fp) > 0 else 0, 4)\n",
    "        metrics['False Positive Rate'] = round(fp / (fp + tn) if (fp + tn) > 0 else 0, 4)\n",
    "    else:\n",
    "        FP = cm.sum(axis=0) - np.diag(cm)\n",
    "        FN = cm.sum(axis=1) - np.diag(cm)\n",
    "        TP = np.diag(cm)\n",
    "        TN = cm.sum() - (FP + FN + TP)\n",
    "        metrics['Specificity'] = round(np.mean(TN / (TN + FP + 1e-10)), 4)\n",
    "        metrics['False Positive Rate'] = round(np.mean(FP / (FP + TN + 1e-10)), 4)\n",
    "\n",
    "    # ROC-AUC\n",
    "    try:\n",
    "        if hasattr(model, \"predict_proba\"):\n",
    "            y_prob = model.predict_proba(X_test)\n",
    "            roc = roc_auc_score(y_test, y_prob[:, 1] if is_binary else y_prob, \n",
    "                                multi_class='ovr' if not is_binary else 'raise', average='weighted')\n",
    "        elif hasattr(model, \"decision_function\"):\n",
    "            y_prob = model.decision_function(X_test)\n",
    "            roc = roc_auc_score(y_test, y_prob)\n",
    "        else:\n",
    "            roc = np.nan\n",
    "        metrics['ROC-AUC'] = round(roc, 4)\n",
    "    except Exception:\n",
    "        metrics['ROC-AUC'] = np.nan\n",
    "\n",
    "    return metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "64585b97",
   "metadata": {},
   "outputs": [],
   "source": [
    "# the 5 Base Models\n",
    "base_models = {\n",
    "    'KNN':               KNeighborsClassifier(n_neighbors=5),\n",
    "    'Naive Bayes':       GaussianNB(),\n",
    "    'Random Forest':     RandomForestClassifier(n_estimators=200, random_state=42, n_jobs=-1),\n",
    "    'AdaBoost':          AdaBoostClassifier(n_estimators=100, random_state=42),\n",
    "    'Gradient Boosting': GradientBoostingClassifier(n_estimators=200, random_state=42)\n",
    "}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "fce810e6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Training KNN...\n",
      "Training Naive Bayes...\n",
      "Training Random Forest...\n",
      "Training AdaBoost...\n",
      "Training Gradient Boosting...\n"
     ]
    }
   ],
   "source": [
    "# Train then Evaluate Base Models\n",
    "base_results = {}\n",
    "\n",
    "for name, model in base_models.items():\n",
    "    print(f\"Training {name}...\")\n",
    "    metrics_dict = evaluate_model(name, model, X_train, y_train, X_test, y_test)\n",
    "    base_results[name] = {'metrics': metrics_dict, 'model': model}\n"
   ]
  },
